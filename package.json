  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "qq",
    "qq-bot",
    "chat",
    "channel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drop-github/dsh-qq-channel-v2.git"
  },
  "homepage": "https://github.com/drop-github/dsh-qq-channel-v2#readme",
  "bugs": {
    "url": "https://github.com/drop-github/dsh-qq-channel-v2/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "ws": "8.21.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6"
  }
}
