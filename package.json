{
  "name": "dsh-qq-channel",
  "version": "2.0.0",
  "description": "QQ official-bot channel for DeepSeek Harness: drive your dsh agent from QQ (C2C/group chat), with Markdown replies, image/file relay, and on-QQ approval confirmations.",
